@page "/client/{ClientId:int}"
@inject NavigationManager NavigationManager
@inject HttpClient Http
@using Syncfusion.Blazor.DataForm
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.Navigations
@using AutoDealerSphere.Client.Components
@using AutoDealerSphere.Shared.Models

<SfBreadcrumb>
    <BreadcrumbItems>
        <BreadcrumbItem IconCss="e-icons e-home" Url="/"/>
        <BreadcrumbItem Text="顧客管理" Url="/clientlist"/>
        <BreadcrumbItem Text="編集" Url="./"/>
    </BreadcrumbItems>
</SfBreadcrumb>

<h2>顧客管理</h2>
<h3>編集</h3>
@if (_initialized)
{
    @if (_item != null)
    {
        <ClientForm Item="_item" OnClickOK="OnClickOK" OnClickDelete="OnClickDelete" />

        <h3>車両一覧</h3>
        <div class="register-form">
            <SfButton CssClass="e-primary" @onclick="AddVehicle">車両を追加</SfButton>
        </div>
        <br />
        @if (_vehicles.Any())
        {
            <SfGrid DataSource="@_vehicles" AllowSorting="true" AllowTextWrap="true">
                <GridColumns>
                    <GridColumn HeaderText="ナンバー" Width="35%">
                        <Template>
                            @{
                                var vehicle = (context as Vehicle);
                                <a href="@($"/vehicle/{vehicle!.Id}")" class="grid-link">@vehicle.LicensePlateDisplay</a>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(Vehicle.VehicleModel)" HeaderText="型式" Width="20%"></GridColumn>
                    <GridColumn Field="@nameof(Vehicle.ChassisNumber)" HeaderText="車台番号" Width="25%"></GridColumn>
                    <GridColumn Field="@nameof(Vehicle.InspectionExpiryDate)" HeaderText="車検満了日" Width="20%" Format="yyyy/MM/dd"></GridColumn>
                </GridColumns>
            </SfGrid>
        }
        else
        {
            <p>車両が登録されていません。</p>
        }

        <h3>請求書一覧</h3>
        <div class="register-form">
            <SfButton CssClass="e-primary" @onclick="CreateInvoice">請求書を作成</SfButton>
        </div>
        <br />
        @if (_invoices.Any())
        {
            <SfGrid DataSource="@_invoices" AllowSorting="true" AllowTextWrap="true">
                <GridColumns>
                    <GridColumn HeaderText="請求書番号" Width="20%">
                        <Template>
                            @{
                                var invoice = (context as Invoice);
                                var displayNumber = invoice!.Subnumber > 1
                                    ? $"{invoice.InvoiceNumber}-{invoice.Subnumber}"
                                    : invoice.InvoiceNumber;
                                <a href="@($"/invoice/detail/{invoice.Id}")" class="grid-link">@displayNumber</a>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="車両" Width="35%">
                        <Template>
                            @{
                                var invoice = (context as Invoice);
                                <span>@(invoice?.Vehicle?.LicensePlateDisplay ?? "-")</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(Invoice.InvoiceDate)" HeaderText="請求日" Width="20%" Format="yyyy/MM/dd"></GridColumn>
                    <GridColumn Field="@nameof(Invoice.Total)" HeaderText="合計金額" Width="20%" TextAlign="TextAlign.Right">
                        <Template>
                            @{
                                var invoice = (context as Invoice);
                                <span>¥@($"{invoice!.Total:N0}")</span>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
        else
        {
            <p>請求書が登録されていません。</p>
        }

        <InvoiceBasicInfoDialog @ref="_invoiceDialog" OnSave="OnInvoiceSaved" />
    }
    else
    {
        <p class="error-message">顧客情報が見つかりません。</p>
    }
}

