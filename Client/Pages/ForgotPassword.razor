@page "/forgot-password"
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card forgot-card">
                <div class="card-header">
                    <h3>パスワードを忘れた場合</h3>
                </div>
                <div class="card-body">
                    @if (step == Step.SelectUser)
                    {
                        <p>ユーザーを選択してください。そのユーザーの登録メールアドレス宛に認証コード（6桁）をお送りします。</p>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="form-group">
                            <label>ユーザー</label>
                            <SfDropDownList TValue="int?" TItem="ResetUserItem"
                                @bind-Value="@selectedUserId"
                                DataSource="@users"
                                Placeholder="ユーザーを選択">
                                <DropDownListFieldSettings Value="Id" Text="Name">
                                </DropDownListFieldSettings>
                            </SfDropDownList>
                        </div>

                        <div class="button-group mt-3">
                            <SfButton CssClass="e-primary" OnClick="SendResetCode" Disabled="@isProcessing">認証コードを送信</SfButton>
                            <SfButton CssClass="e-outline" OnClick="GoToLogin">ログインに戻る</SfButton>
                        </div>
                    }
                    else if (step == Step.EnterCode)
                    {
                        <div class="alert alert-success">
                            <p>登録メールアドレス（@maskedEmail）宛に認証コードを送信しました。</p>
                            <p>メールに記載された6桁の認証コードと、新しいパスワードを入力してください。コードは15分間有効です。</p>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="form-group">
                            <label>認証コード（6桁）</label>
                            <SfTextBox @bind-Value="@verificationCode" Placeholder="認証コードを入力してください"></SfTextBox>
                        </div>
                        <div class="form-group mt-2">
                            <label>新しいパスワード</label>
                            <SfTextBox @bind-Value="@newPassword" Type="InputType.Password" Placeholder="新しいパスワード（6文字以上）"></SfTextBox>
                        </div>
                        <div class="form-group mt-2">
                            <label>新しいパスワード（確認）</label>
                            <SfTextBox @bind-Value="@confirmPassword" Type="InputType.Password" Placeholder="新しいパスワードを再入力"></SfTextBox>
                        </div>

                        <div class="button-group mt-3">
                            <SfButton CssClass="e-primary" OnClick="ResetPasswordAsync" Disabled="@isProcessing">パスワードを変更</SfButton>
                            <SfButton CssClass="e-outline" OnClick="BackToSelectUser" Disabled="@isProcessing">ユーザー選択に戻る</SfButton>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <p>パスワードを変更しました。</p>
                            <p>新しいパスワードでログインしてください。</p>
                        </div>
                        <SfButton CssClass="e-primary" OnClick="GoToLogin">ログインへ</SfButton>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .forgot-card {
        max-width: 560px;
        margin: 0 auto;
    }

    /* 入力欄は全幅にせず固定幅にする */
    .forgot-card .form-group {
        max-width: 320px;
        margin-bottom: 1rem;
    }

    .forgot-card .form-group label {
        display: block;
        margin-bottom: 4px;
    }

    /* ボタン列は入力欄から一行分空ける */
    .forgot-card .button-group {
        margin-top: 2.5rem;
        display: flex;
        gap: 8px;
    }
</style>
