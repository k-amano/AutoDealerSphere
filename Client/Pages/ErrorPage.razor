@page "/error"
@inject ErrorService ErrorService
@inject NavigationManager NavigationManager
@using AutoDealerSphere.Client.Services

<PageTitle>エラー</PageTitle>

<div class="error-container">
    <div class="error-card">
        <div class="error-icon">⚠</div>
        <h2 class="error-title">処理中にエラーが発生しました</h2>

        <p class="error-message">
            操作を完了できませんでした。<br>
            しばらく時間をおいてから再度お試しください。<br>
            問題が解決しない場合は、下記のエラーIDをサポートまでお知らせください。
        </p>

        @if (!string.IsNullOrEmpty(ErrorService.CurrentError?.TraceId))
        {
            <div class="error-trace">
                <span class="error-trace-label">エラーID（サポートへの問い合わせ時にお伝えください）</span>
                <code class="error-trace-id">@ErrorService.CurrentError.TraceId</code>
            </div>
        }

        <div class="error-actions">
            <button class="btn-back" @onclick="GoHome">ホームに戻る</button>
        </div>
    </div>
</div>

@code {
    private void GoHome()
    {
        ErrorService.Clear();
        NavigationManager.NavigateTo("/");
    }
}

<style>
    .error-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
        padding: 20px;
    }

    .error-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 40px;
        max-width: 600px;
        width: 100%;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .error-icon {
        font-size: 48px;
        color: #e53935;
        margin-bottom: 16px;
    }

    .error-title {
        font-size: 22px;
        color: #333;
        margin: 0 0 16px;
    }

    .error-message {
        color: #555;
        font-size: 15px;
        margin-bottom: 24px;
        white-space: pre-wrap;
        text-align: left;
    }

    .error-trace {
        background: #f5f5f5;
        border-radius: 4px;
        padding: 12px 16px;
        margin-bottom: 28px;
        text-align: left;
    }

    .error-trace-label {
        display: block;
        font-size: 12px;
        color: #888;
        margin-bottom: 6px;
    }

    .error-trace-id {
        font-size: 13px;
        color: #333;
        word-break: break-all;
    }

    .error-actions {
        display: flex;
        justify-content: center;
    }

    .btn-back {
        background-color: #1976d2;
        color: white;
        border: none;
        border-radius: 4px;
        padding: 10px 28px;
        font-size: 14px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-back:hover {
        background-color: #1565c0;
    }
</style>
